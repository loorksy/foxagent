# FoxAgent environment
# Required for the agent. Must be a real Anthropic key that can create messages.
ANTHROPIC_API_KEY=
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
DEFAULT_CLAUDE_MODEL=claude-sonnet-4-5

# Optional persistence
DATABASE_URL=sqlite+aiosqlite:///./backend/data/foxagent.db
REDIS_URL=
SETTINGS_SECRET=

# Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Telegram trade alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_TELEGRAM_NOTIFICATIONS=false

# Frontend
NEXT_PUBLIC_WS_URL=
BACKEND_URL=http://127.0.0.1:8000
